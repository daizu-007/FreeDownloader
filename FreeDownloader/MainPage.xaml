<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FreeDownloader.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FreeDownloader"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="Welcome to FreeDownloader!"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <TextBlock Text="ダウンロードしたいURL:"
                           Opacity="0.6"
                           HorizontalAlignment="Center" />
                <TextBox x:Name="UrlTextBox"
                         PlaceholderText = "URLを入力してください"
                         Width="300"
                         HorizontalAlignment="Center" />
            </StackPanel>
            <Button x:Name="DownloadButton"
                    Content="ダウンロード"
                    HorizontalAlignment="Stretch"
                    Click="DownloadButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="キャンセル"
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"
                    Click="CancelButton_Click"/>
            <!-- 進捗とログ -->
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center"/>
            <ScrollViewer Height="200" BorderBrush="Gray" BorderThickness="1">
                <TextBlock x:Name="ResultText" Text="" TextWrapping="Wrap" Padding="8" IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
