<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FreeDownloader.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="設定" FontSize="24" FontWeight="Bold"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="外観" FontSize="16" FontWeight="SemiBold"/>
                    <ComboBox Header="ウィンドウの背景"
                              SelectedValuePath="Tag"
                              SelectedValue="{x:Bind Settings.WindowBackdrop, Mode=TwoWay}"
                              Width="200"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="Mica" Tag="Mica"/>
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt"/>
                        <ComboBoxItem Content="Desktop Acrylic" Tag="DesktopAcrylic"/>
                        <ComboBoxItem Content="単色" Tag="Solid"/>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="ダウンロード" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="ダウンロードディレクトリ" FontWeight="SemiBold"/>
                    <TextBox Text="{x:Bind Settings.DownloadDirectory, Mode=TwoWay}" PlaceholderText="ダウンロード先のディレクトリを入力してください"/>
                    <TextBlock Text="ブラウザのCookieを使用する" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CookieBrowserComboBox"
                              SelectedValuePath="Tag"
                              SelectedValue="{x:Bind Settings.CookieBrowser, Mode=TwoWay}"
                              Width="200"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="使用しない" Tag="none"/>
                        <ComboBoxItem Content="Chrome" Tag="chrome"/>
                        <ComboBoxItem Content="Microsoft Edge" Tag="edge"/>
                        <ComboBoxItem Content="Firefox" Tag="firefox"/>
                        <ComboBoxItem Content="Brave" Tag="brave"/>
                        <ComboBoxItem Content="Vivaldi" Tag="vivaldi"/>
                        <ComboBoxItem Content="Opera" Tag="opera"/>
                        <ComboBoxItem Content="Zen Browser" Tag="zen"/>
                        <ComboBoxItem Content="Floorp" Tag="floorp"/>
                        <ComboBoxItem Content="Helium" Tag="helium"/>
                        <ComboBoxItem Content="カスタム" Tag="custom"/>
                    </ComboBox>
                    <StackPanel Spacing="8" Visibility="{x:Bind CustomCookieSettingsVisibility(Settings.CookieBrowser), Mode=OneWay}">
                        <ComboBox Header="Cookieの読み取り方法"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{x:Bind Settings.CustomCookieSource, Mode=TwoWay}">
                            <ComboBoxItem Content="Firefox系のプロファイル" Tag="firefox"/>
                            <ComboBoxItem Content="Chromium系のプロファイル" Tag="chromium"/>
                            <ComboBoxItem Content="Cookieファイル（Netscape形式）" Tag="file"/>
                        </ComboBox>
                        <StackPanel Spacing="4" Visibility="{x:Bind CookieProfileVisibility(Settings.CustomCookieSource), Mode=OneWay}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Header="プロファイルのフォルダー"
                                         Text="{x:Bind Settings.CustomCookieProfilePath, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Content="参照…" VerticalAlignment="Bottom" Click="BrowseCookieProfile_Click"
                                        AutomationProperties.Name="プロファイルのフォルダーを選択"/>
                            </Grid>
                            <TextBlock Text="Firefox系は about:profiles の「ルートディレクトリー」、Chromium系は chrome://version の「プロフィール パス」に表示されるフォルダーを指定してください。"
                                       Opacity="0.6" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                              Visibility="{x:Bind CookieFileVisibility(Settings.CustomCookieSource), Mode=OneWay}">
                            <TextBox Header="Cookieファイルのパス"
                                     Text="{x:Bind Settings.CustomCookieFilePath, Mode=TwoWay}"/>
                            <Button Grid.Column="1" Content="参照…" VerticalAlignment="Bottom" Click="BrowseCookieFile_Click"
                                    AutomationProperties.Name="Cookieファイルを選択"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="選択したブラウザのCookieをyt-dlpに渡し、ログインが必要なサイトで使用します。Chromium系のブラウザは完全に終了してから実行してください。直接読み取れない場合は「カスタム」でCookieファイルを指定できます。"
                               Opacity="0.6"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="ツールの管理" FontSize="16" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="アプリ管理のツールを使用する(推奨)"
                                  IsOn="{x:Bind Settings.UseManagedTools, Mode=TwoWay}"/>
                    <TextBlock Text="yt-dlpの実行ファイルパス" FontWeight="SemiBold"/>
                    <TextBox Text="{x:Bind Settings.YtDlpExecutablePath, Mode=TwoWay}" PlaceholderText="yt-dlpの実行ファイルパスを入力してください"/>
                    <TextBlock Text="ffmpegの実行ファイルパス" FontWeight="SemiBold"/>
                    <TextBox Text="{x:Bind Settings.FfmpegExecutablePath, Mode=TwoWay}" PlaceholderText="ffmpegの実行ファイルパスを入力してください"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
