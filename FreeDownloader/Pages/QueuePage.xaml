<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FreeDownloader.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:FreeDownloader.Services"
    mc:Ignorable="d">
    <Grid Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="ダウンロードキュー" FontSize="24" FontWeight="Bold"/>
            <!-- キュー全体を囲む Border -->
            <ListView x:Name="QueueList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:DownloadItem">
                        <!-- 各アイテムをカード風に囲む Border -->
                        <Border
                            Margin="0,4"
                            Padding="12"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Url}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" Opacity="0.6" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="一時停止"
                                            IsEnabled="{x:Bind IsDownloading, Mode=OneWay}"
                                            Click="PauseButton_Click"/>
                                    <Button Content="再開"
                                            IsEnabled="{x:Bind IsPaused, Mode=OneWay}"
                                            Click="ResumeButton_Click"/>
                                    <Button Content="キャンセル"
                                            IsEnabled="{x:Bind IsActive, Mode=OneWay}"
                                            Click="CancelButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
