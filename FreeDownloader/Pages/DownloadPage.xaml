<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FreeDownloader.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24">
        <StackPanel Spacing="16">
            <!-- タイトル -->
            <TextBlock Text="ダウンロード"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Left" />
            <!-- ダウンロード -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <!-- URL欄 -->
                    <StackPanel Orientation="Vertical" 
                                HorizontalAlignment="Left"
                                Spacing="8">
                        <TextBlock Text="動画のURL"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Spacing="8">
                            <TextBox x:Name="UrlTextBox"
                                     PlaceholderText = "URLを入力してください"
                                     Width="300"
                                     HorizontalAlignment="Center" />
                            <Button x:Name="DownloadButton"
                                    Content="キューに追加"
                                    HorizontalAlignment="Stretch"
                                    Click="DownloadButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- オプション設定 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Spacing="16">
                        <!-- 画質 -->
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Left"
                                    Spacing="8">
                            <TextBlock Text="画質"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="QualityComboBox"
                                      Width="150"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="0">
                                <!-- Tag に yt-dlp に渡す値を入れておく -->
                                <ComboBoxItem Content="最高画質" Tag="best" />
                                <ComboBoxItem Content="1080p" Tag="1080" />
                                <ComboBoxItem Content="720p" Tag="720" />
                                <ComboBoxItem Content="480p" Tag="480" />
                                <ComboBoxItem Content="360p" Tag="360" />
                            </ComboBox>
                        </StackPanel>
                        <!-- ファイル形式 -->
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Left"
                                    Spacing="8">
                            <TextBlock Text="ファイル形式"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="FormatComboBox"
                                      Width="150"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="MP4" Tag="mp4" />
                                <ComboBoxItem Content="MKV" Tag="mkv" />
                                <ComboBoxItem Content="WebM" Tag="webm" />
                            </ComboBox>
                        </StackPanel>
                        <!-- 音声のみにするか -->
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Left"
                                    Spacing="8">
                            <TextBlock Text="オーディオのみ"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="AudioOnlyToggle"
                                          HorizontalAlignment="Left"
                                          Toggled="AudioOnlyToggle_Toggled"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 状態メッセージ -->
                    <TextBlock x:Name="ResultText" Text="" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
